# ════════════════════════════════════════════════════════════════════════════
#  JH Inversiones · Variables de entorno para Vercel
#  Vercel → proyecto → Settings → Environment Variables → pega este contenido
#  (Vercel acepta pegar un .env completo) y reemplaza cada valor en MAYÚSCULAS / PEGAR_AQUI.
#  Marca los entornos Production y Preview. Después: Deployments → Redeploy.
#  Guía completa: docs/CONFIGURACION.md
# ════════════════════════════════════════════════════════════════════════════

# ── Sitio ──────────────────────────────────────────────────────────────────
# Dominio final, sin barra al final (o el https://<proyecto>.vercel.app mientras tanto).
NEXT_PUBLIC_SITE_URL=https://TU-DOMINIO.com

# ── Supabase ── Project Settings → API Keys ───────────────────────────────
# Project URL (Project Settings → Data API, o la barra de "Connect").
NEXT_PUBLIC_SUPABASE_URL=https://ID-DEL-PROYECTO.supabase.co
# Publishable key (sb_publishable_…). También sirve la "anon" de Legacy API Keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_PEGAR_AQUI
# Secret key (sb_secret_…). También sirve la "service_role" de Legacy API Keys. SECRETA.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_PEGAR_AQUI

# ── Administradores ── correos con acceso a /admin (separados por comas) ───
ADMIN_EMAILS=cliente@TU-DOMINIO.com

# ── Pagos ── métodos que ve el cliente al invertir ─────────────────────────
#   test     = pago de prueba ("Pago de prueba aceptado"; no cobra dinero)
#   transfer = transferencia bancaria que el administrador confirma
# Para operar con dinero real deja solo:  NEXT_PUBLIC_PAYMENT_METHODS=transfer
NEXT_PUBLIC_PAYMENT_METHODS=test,transfer

# ── Contacto público (pie de página, preguntas frecuentes y términos) ──────
NEXT_PUBLIC_CONTACT_EMAIL=contacto@TU-DOMINIO.com
# WhatsApp con código de país, solo dígitos (ej. 573001234567). Vacío = no se muestra.
NEXT_PUBLIC_CONTACT_WHATSAPP=573001234567

# ── Resend ── avisos de pagos y retiros (resend.com → API Keys) ────────────
RESEND_API_KEY=re_PEGAR_AQUI
# Remitente en un dominio verificado en Resend.
RESEND_FROM_EMAIL="JH Inversiones <avisos@TU-DOMINIO.com>"
# Bandeja que recibe los avisos para el administrador.
ADMIN_NOTIFICATION_EMAIL=cliente@TU-DOMINIO.com

# ── Pasarela de pago con tarjeta (FASE PENDIENTE) ── dejar así ─────────────
PAYMENTS_APPROVED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
