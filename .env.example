# Copia este archivo como .env.local (local) o carga estas variables en Vercel → Settings → Environment Variables.
# Nunca subas .env.local al repositorio: ya está en .gitignore.

# URL pública del sitio (sin barra final). Se usa en enlaces de correo y metadatos.
NEXT_PUBLIC_SITE_URL=https://tudominio.com

# ── Supabase (OBLIGATORIO) ── Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta del servidor (service_role). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Correos que tendrán rol de administrador (separados por comas). Deben confirmar su correo.
ADMIN_EMAILS=admin@tudominio.com

# ── Pagos ── Métodos que ve el cliente al invertir (separados por comas):
#   test     = pago de prueba (no cobra; la inversión queda activa al instante). ¡Quitarlo en producción real!
#   transfer = transferencia bancaria; el administrador confirma el pago en /admin/pagos.
#   stripe   = pasarela con tarjeta (FASE PENDIENTE, ver docs/pasarela-de-pagos.md).
NEXT_PUBLIC_PAYMENT_METHODS=test,transfer
# Solo para la pasarela (stripe):
PAYMENTS_APPROVED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Contacto público (opcional; se muestra en el pie de página, preguntas y términos) ──
NEXT_PUBLIC_CONTACT_EMAIL=contacto@tudominio.com
# Número de WhatsApp con código de país, solo dígitos (ej. 573001234567).
NEXT_PUBLIC_CONTACT_WHATSAPP=

# ── Resend (opcional): avisos por correo al administrador (pagos y retiros) y a los clientes (confirmaciones) ──
RESEND_API_KEY=
RESEND_FROM_EMAIL=notificaciones@tudominio.com
ADMIN_NOTIFICATION_EMAIL=admin@tudominio.com
