# Demostración (valor predeterminado). No procesa pagos ni envía correos.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Activar SOLO después de validar requisitos legales y aceptación del proveedor.
PAYMENTS_APPROVED=false

# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe: uso exclusivo si Stripe aprueba expresamente este modelo de inversión.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend: dominio verificado para avisos al administrador.
RESEND_API_KEY=
RESEND_FROM_EMAIL=notificaciones@tudominio.com
ADMIN_NOTIFICATION_EMAIL=admin@tudominio.com
